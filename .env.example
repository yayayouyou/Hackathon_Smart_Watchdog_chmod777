# 小小守護員 — 憑證設定
#
# 複製成 .env 後填入。外部 API 憑證皆為選配：分析管線、靜態版、新聞與 PTT
# 不需要金鑰；動態版登入則必須設定檔案末尾的兩組身分帳號。API 憑證只會開啟
# 更多即時管道，不會改變核心分析。
#
# .env 已列入 .gitignore，不會進版控。

# ── Google Maps Platform ────────────────────────────────────────────
# 開啟：卷宗內的 Google 地圖評論（即時顯示，不入庫）；另可切換 Google 底圖
# 申請：https://console.cloud.google.com
#   1) 建立專案 → 2) 啟用「Places API (New)」→ 3) 憑證 → 建立 API 金鑰
#   4) 限制該金鑰只能用 Places API（避免誤用與超額）
# 費用：Place Details 含 reviews 落在 Enterprise + Atmosphere 級距，
#       每千次 US$25，每月前 1,000 次免費（各級距免費額度獨立不共用）
GOOGLE_MAPS_API_KEY=

# ── Threads（Meta）──────────────────────────────────────────────────
# 開啟兩個管道，門檻不同：
#   1) @標註官方帳號的民眾通報（/me/mentions）——**有權杖就能用**，
#      不需要 App Review。這是民眾主動寄給我們的，不是我們去搜的。
#   2) 公開貼文關鍵字搜尋——另需 threads_keyword_search 權限並過 App Review。
# 申請：https://developers.facebook.com（詳見 docs/architecture/API申請指引.md）
THREADS_ACCESS_TOKEN=

# 只收這個時間點之後的 @標註（ISO-8601）。**強烈建議填。**
# 不填的話，第一次同步會把帳號歷年被標註的貼文全部匯入，
# 每一則都會帶著今天的觀測時間，看起來像今天湧進來的通報。
THREADS_MENTIONS_NOT_BEFORE=

# ── 輿情監測服務（OpView／QSearch／KEYPO）────────────────────────────
# 開啟：PTT／Dcard／FB 公開社團／Threads 的全網覆蓋
# 取得：循共同供應契約採購，要求供應每日檔案或 API
# 填入每日檔案的本機路徑
VENDOR_FEED_PATH=

# ── AWS Bedrock（決賽當天）───────────────────────────────────────────
# 開啟：財報視覺抽取、稽查建議書生成、自然語言查詢改用 Bedrock
# 競賽規定僅限 AWS 提供之基礎模型；模型 ID 需 anthropic. 前綴
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── 雙身分登入（⚠️ 四個帳密變數皆需設定）────────────────────────────
# 動態版有全螢幕登入牆。兩個帳號各自固定一個 role，但目前介面、功能與預設
# 查詢範圍完全相同；role 只作身分顯示與稽核 metadata，不是權限邊界。
# 填好後執行：python run.py seed-users
# 腳本冪等；重跑會同步名稱、role、全市範圍與密碼。兩組 Email 不可相同。
SEED_INSPECTOR_EMAIL=
SEED_INSPECTOR_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# 展示環境的一鍵免密碼登入。正式環境維持 false；只有本機／受控 demo 才設 true。
# 後端只會依上述 Email 找已 seed、active 且 role 相符的帳號，不會把密碼送到前端。
QUICK_LOGIN_ENABLED=false
