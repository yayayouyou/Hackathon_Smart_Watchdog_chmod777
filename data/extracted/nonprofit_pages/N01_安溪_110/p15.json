 "text_sections": [
  {
   "heading": "(三）營運資產 1. 代管財產",
   "text": "110 及 109 學年度代管財產分別減少 148,969 元及 185,914 元，係託管單位財產管理系統，依財產經濟年限攤提折舊與部分設備報廢所致。"
  },
  {
   "heading": "(三）營運資產 2. 購置財產",
   "text": "本幼兒園依契約之規定應辦理保險，截至 111 年 7 月 31 日及 110 年 7 月 31 日止保險金額均為 14,500,000 元。"
  }
 ],
 "issues": [
  "代管財產表中「本期增加」欄顯示為「$ -」，視為空白填null；購置財產109學年度「本期減少」欄亦顯示為「$ -」，視為空白填null。",
