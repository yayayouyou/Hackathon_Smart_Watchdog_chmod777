 "text_sections": [
  {
   "heading": "(三) 營運資產 1. 代管財產",
   "text": "110 及 109 學年度代管財產分別減少 298,531 元及 298,536 元，係託管單位財產管理系統，依財產經濟年限擺提折舊所致。"
  },
  {
   "heading": "(三) 營運資產 2. 購置財產",
   "text": "本幼兒園依契約之規定應辦理保險，截至 111 年 7 月 31 日及 110 年 7 月 31 日止保險金額均為 35,000,000 元。"
  }
 ],
