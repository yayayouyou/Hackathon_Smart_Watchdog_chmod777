 "text_sections": [
  {
   "heading": "(三) 營運資產 1. 代管財產",
   "text": "113 及 112 學年度代管財產分別減少 665,441 元及 580,380 元，係託管單位財產管理系統，依財產經濟年限攤提折舊所致。"
  },
  {
   "heading": "(三) 營運資產 2. 購置財產",
   "text": "本幼兒園依契約之規定應辦理保險，截至 114 年 7 月 31 日及 113 年 7 月 31 日止保險金額均為 22,000,000 元。"
  }
 ],
